# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Anthropic API key (console.anthropic.com) — used server-side (Vite dev
# middleware) by the chess opponent to call the Messages API.
# Without this set, the opponent falls back to picking a random legal move.
ANTHROPIC_API_KEY=

# Chroma Cloud credentials (from your Chroma dashboard) — used server-side to
# query the chess-knowledge RAG collection.
# Without these set, the opponent skips RAG grounding.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
